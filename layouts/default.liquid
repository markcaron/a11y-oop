<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="description" content="{{ page.description | default: 'Practical accessibility guidance, a shared checklist, and modular AI skills for every stage of your work.' | escape }}">
  <title>{{ page.title | escape }} · a11y oop</title>
  <link rel="icon" href="/assets/mark.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/site.css">
  <link rel="stylesheet" href="/assets/felt-theme.css">
  <link rel="preload" href="/assets/fonts/RedHatText-VF.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/RedHatDisplay-VF.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header wrap">
    {% include "partials/brand" %}
    <nav aria-label="Main"><a href="/checklist/" {% if page.section == 'checklist' %}aria-current="page"{% endif %}>Checklist</a><a href="/guidelines/" {% if page.section == 'guidelines' %}aria-current="true"{% endif %}>Guidelines</a><a href="/skills/" {% if page.section == 'skills' %}aria-current="true"{% endif %}>AI skills <span aria-hidden="true">↗</span></a></nav>
  </header>
  <main id="main" class="wrap" tabindex="-1">{{ content }}</main>
  <footer class="site-footer wrap"><p><strong>Access is a shared responsibility.</strong><br>Built for people. Useful across PF, RHDS and the future Felt.</p><nav aria-label="Footer"><a href="/about/">About &amp; sources</a><a href="/data/checklist.json" download>Checklist JSON</a><a href="/skills/recipes/">Workflow recipes</a></nav><p class="small">An evolving working library. A completed checklist is evidence of work, not a conformance claim.</p></footer>
  <script type="module" src="/assets/site.js"></script>
</body>
</html>
